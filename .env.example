# Example environment variables for CryptoLaunchAgent (Phase 2)
# Copy this to `.env` and adjust values for your environment.

# Environment: development or production
ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application version (kept in VERSION file too)
APP_VERSION=0.1.0

# Optional BSC RPC placeholder (no network calls in Phase 2)
BSC_RPC_URL=

# Paper trading toggle (true/false)
PAPER_TRADING=true

# Paths
DATA_DIR=data
LOGS_DIR=logs
 
# PancakeSwap factory address (mainnet BSC example)
# PANCAKE_FACTORY_ADDRESS=0xca143ce32fe78f1f7019d7d551a6402fc5350c73
