# Example environment variables for CryptoLaunchAgent (Phase 2)
# Copy this to `.env` and adjust values for your environment.

# Environment: development or production
ENV=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application version (kept in VERSION file too)
APP_VERSION=0.1.0

# Optional BSC RPC placeholder (no network calls in Phase 2)
BSC_RPC_URL=

# Paper trading toggle (true/false)
PAPER_TRADING=true

# Paths
DATA_DIR=data
LOGS_DIR=logs
